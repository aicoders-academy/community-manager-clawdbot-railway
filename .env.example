# Railway / OpenClaw
SETUP_PASSWORD=
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace
OPENCLAW_GATEWAY_TOKEN=

# AI engine
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Circle Admin API
# Required to use Circle.
CIRCLE_API_TOKEN=

# Optional. By default the bot tries to discover all spaces automatically.
# Use this only if you want to restrict collection to specific spaces.
# Example: CIRCLE_SPACE_IDS=123,456,789
CIRCLE_SPACE_IDS=

# Optional compatibility for a single space.
CIRCLE_SPACE_ID=

# Optional. Defaults to https://app.circle.so/api
CIRCLE_API_BASE_URL=https://app.circle.so/api

# WhatsApp via Evolution API
# Optional. If missing, the bot still works with Circle/Slack.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Accepted aliases for Evolution API URL/key.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Comma-separated WhatsApp group IDs allowed for processing.
# Example: ALLOWED_GROUPS=120363000000000000@g.us,120363111111111111@g.us
ALLOWED_GROUPS=

# Slack outbound digest via Incoming Webhook
# Optional. Used by POST /community-manager/slack/tasks.
SLACK_WEBHOOK_URL=

# Slack chat via Events API
# Optional, but required if you want to mention or DM the bot in Slack.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional comma-separated Slack channel IDs. Empty means any channel where the app receives events.
# Example: SLACK_ALLOWED_CHANNELS=C1234567890,C0987654321
SLACK_ALLOWED_CHANNELS=

# Optional AI news RSS source
AI_NEWS_RSS_URL=https://news.google.com/rss/search?q=artificial+intelligence
